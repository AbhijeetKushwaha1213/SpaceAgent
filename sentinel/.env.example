# ─────────────────────────────────────────────────────────────────────────────
# SENTINEL — environment configuration (Phase 14: Security & Data Handling)
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# Reasoning mode: cloud | local | fallback | tuned | base | stub
# LOCAL / fallback: all inference stays on this host; the cloud provider
# boundary refuses any Gemini call, and no telemetry leaves the machine.
LLM_MODE=cloud
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local

# ── API authentication ───────────────────────────────────────────────────────
# When set, every request must present the key via `X-API-Key: <key>` or
# `Authorization: Bearer <key>` (PRODUCTION_AUTHENTICATED mode).
# Auth is FAIL-CLOSED by default: with this UNSET the server returns HTTP 401 to
# every request. Leaving it unset does NOT grant open access. For the local
# demo, keep this unset and start the backend with SECURE_DEV_MODE=1 (below) —
# that, not an unset key, is what serves the API unauthenticated on localhost.
# SENTINEL_API_KEY=

# ── Rate limiting (requests/min, per client IP) ──────────────────────────────
# Default: 120 in production, 1200 in the demo (SECURE_DEV_MODE=1) — all local
# demo traffic shares one 127.0.0.1 bucket, so 120 is too tight for interactive
# use. Set this explicitly to override either default (wins in both modes).
# SENTINEL_RATE_LIMIT=120
# SENTINEL_MAX_PAYLOAD_BYTES=10485760

# ── CORS allowlist (comma-separated; explicit, never wildcard) ───────────────
# SENTINEL_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Redacted logging ─────────────────────────────────────────────────────────
# SECURE_DEV_MODE=1 disables log redaction — NEVER set this outside a
# dedicated development environment. Logs are redacted by default.
# SECURE_DEV_MODE=0

# ── Cloud-mode data redaction ────────────────────────────────────────────────
# Before any external LLM call, telemetry points whose parameter name appears
# here are removed entirely from the transmitted payload. The removal is
# recorded in the audit trail (external_transmission stage).
# SENTINEL_CLOUD_REDACT_PARAMETERS=GYRO_A_RATE,BUS_VOLTAGE
