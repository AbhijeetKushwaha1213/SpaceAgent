{
  "additionalProperties": false,
  "description": "Envelope for ``GET /api/v1/audit/status``.",
  "properties": {
    "append_only": {
      "default": true,
      "description": "Whether the store enforces append-only semantics",
      "title": "Append Only",
      "type": "boolean"
    },
    "audit_schema_version": {
      "default": "1.0.0",
      "title": "Audit Schema Version",
      "type": "string"
    },
    "backend": {
      "description": "Store implementation in use",
      "title": "Backend",
      "type": "string"
    },
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "enforcement": {
      "description": "The mechanisms actually in force, for an auditor to check",
      "items": {
        "type": "string"
      },
      "title": "Enforcement",
      "type": "array"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "location": {
      "description": "Database location",
      "title": "Location",
      "type": "string"
    },
    "not_implemented_stages": {
      "description": "Stages this build records as NOT_IMPLEMENTED on every run. Exposed so a client cannot mistake their absence for a passing check.",
      "items": {
        "type": "string"
      },
      "title": "Not Implemented Stages",
      "type": "array"
    },
    "run_count": {
      "minimum": 0,
      "title": "Run Count",
      "type": "integer"
    },
    "stages_recorded": {
      "items": {
        "type": "string"
      },
      "title": "Stages Recorded",
      "type": "array"
    }
  },
  "required": [
    "backend",
    "location",
    "run_count"
  ],
  "title": "AuditStatusResponse",
  "type": "object"
}
