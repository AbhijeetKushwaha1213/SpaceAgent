{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "routes": [
    { "src": "/config.js", "dest": "/config.js" },
    { "src": "/vendor/(.*)", "dest": "/vendor/$1" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/dashboard/static/(.*)", "dest": "/static/$1" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/dashboard/", "dest": "/dashboard/index.html" },
    { "src": "/dashboard/(.*)", "dest": "/dashboard/index.html" },
    { "src": "/public/landing.html", "dest": "/public/landing.html" },
    { "src": "/landing.html", "dest": "/public/landing.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
